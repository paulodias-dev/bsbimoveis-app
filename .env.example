EXPO_PUBLIC_API_BASE_URL=https://host.bsbimoveis.com.br/api
EXPO_PUBLIC_FRONTEND_URL=https://bsbimoveis.com.br

# OAuth Google. Crie credenciais separadas no Google Cloud Console.
# native | authsession | disabled
EXPO_PUBLIC_GOOGLE_AUTH_MODE=native
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_IOS_URL_SCHEME=

# Chaves restritas por bundle/package para builds de produção.
EXPO_PUBLIC_GOOGLE_MAPS_ANDROID_API_KEY=
EXPO_PUBLIC_GOOGLE_MAPS_IOS_API_KEY=

# Preenchido depois de executar eas init.
EXPO_PUBLIC_EAS_PROJECT_ID=
